[Unit]
Description=powerdisplay - switch display mode and power profile with the AC adapter
Documentation=https://github.com/emanuel/powerdisplay
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=@BINDIR@/powerdisplayd
Restart=on-failure
RestartSec=5

# The daemon only talks to the compositor, the session bus and /sys; it never needs to
# write anything outside its own config directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/powerdisplay
PrivateTmp=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes

[Install]
# default.target rather than graphical-session.target: not every window manager sets the
# graphical session up, and the daemon retries until the compositor is reachable anyway.
WantedBy=default.target
